# ==============================================================================
# Z Shop - Environment Variables Configuration
# Copy this file to .env.local for local development.
# Configure these in Vercel Project Settings > Environment Variables for Production.
# ==============================================================================

# Gemini AI API Key (Required for AI Shopping Advisor & Smart Recommendations)
# Get key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Base URL (Used for API calls, redirects, and self-referential links)
# Local development default: http://localhost:3000
# Production Vercel URL: https://z-shop-online.vercel.app
APP_URL="https://z-shop-online.vercel.app"
NEXT_PUBLIC_APP_URL="https://z-shop-online.vercel.app"

# Node Environment
NODE_ENV="production"
